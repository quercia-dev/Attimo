@tailwind base;
@tailwind components;
@tailwind utilities;
@tailwind variants;

html,
body {
	@apply h-full overflow-hidden;
}

.calendar-container {
  width: 100%;
  height: 100%;
  overflow: auto;
  mask-image: linear-gradient(to bottom, black calc(100% - 2rem), transparent 100%);
  -webkit-mask-image: linear-gradient(to bottom, black calc(100% - 2rem), transparent 100%);
}

.slider {
	height: 10px;
	background: transparent;
	cursor: row-resize;
}

.feather {
  width: 24px;
  height: 24px;
  stroke: currentColor;
  stroke-width: 2;
  stroke-linecap: round;
  stroke-linejoin: round;
  fill: none;
}

.icon-button {
	position: relative;
	padding: 0.3rem;
	border-radius: 8px;
	border: 4px solid transparent;
	transition:
		box-shadow 0.2s ease,
		background-color 0.6s ease;
}

	.icon-container {
	  display: flex;
	  align-items: center; 
	}
  
	.icon-button {
	  display: inline-flex;
	  align-items: center;
	}

.icon-button:active {
	box-shadow: 0 0 0 2px;
	transition:
		background-color 0.2s ease,
		box-shadow 0.2s ease;
}

.icon-button:active {
	animation: active-click 0.6s forwards;
}
