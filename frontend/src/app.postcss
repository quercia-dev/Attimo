@tailwind base;
@tailwind components;
@tailwind utilities;
@tailwind variants;

html,
body {
	@apply h-full overflow-hidden;
}

.icon-button {
  position: relative;
  padding: 10px;
  border-radius: 8px;
  border: 4px solid transparent;
  transition: box-shadow 0.2s ease, background-color 0.6s ease;
}

.icon-button:active {
  box-shadow: 0 0 0 2px;
  transition: background-color 0.2s ease, box-shadow 0.2s ease;
}

.icon-button:active {
  animation: active-click 0.6s forwards;
}


