@tailwind base;
@tailwind components;
@tailwind utilities;
@tailwind variants;

html,
body {
	@apply h-full overflow-hidden;
}

.calendar-container {
	width: 100%;
	height: 100%;
	overflow: auto;
	mask-image: linear-gradient(to bottom, black calc(100% - 2rem), transparent 100%);
	-webkit-mask-image: linear-gradient(to bottom, black calc(100% - 2rem), transparent 100%);
}

.slider {
	height: 10px;
	background: transparent;
	cursor: row-resize;
}

.feather {
	width: 24px;
	height: 24px;
	stroke: currentColor;
	stroke-width: 2;
	stroke-linecap: round;
	stroke-linejoin: round;
	fill: none;
}

.icon-button {
	display: inline-flex;
	align-items: center;
	position: relative;
	padding: 0.3rem;
	border-radius: 8px;
	border: 4px solid transparent;
	transition:
		box-shadow 0.1s ease,
		background-color 0.1s ease;
}

.icon-container {
	display: flex;
	align-items: center;
}

.small-icon-button {
	display: inline-flex;
	align-items: center;
	position: relative;
	border-radius: 8px;
	border: 4px solid transparent;
	transition:
		box-shadow 0.1s ease,
		background-color 0.1s ease;
}

.icon-button:active {
	box-shadow: 0 0 0 1px;
	transition:
		background-color 0.2s ease,
		box-shadow 0.2s ease;
}

.no-select {
	user-select: none;
}
