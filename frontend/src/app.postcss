@tailwind base;
@tailwind components;
@tailwind utilities;
@tailwind variants;

html,
body {
	@apply h-full overflow-hidden;
}

/* rocket theme */
@font-face {
	font-family: 'Space Grotesk';
	src: url('/fonts/SpaceGrotesk.ttf');
	font-display: swap;
}

.icon-button {
  position: relative;
  padding: 5px;
  border-radius: 8px;
  border: 4px solid transparent;
  transition: border 0.2s ease, box-shadow 0.2s ease, background-color 0.6s ease;
}

.icon-button:hover {
  box-shadow: 0 0 0 2px black;
  background-color: rgba(0, 0, 0, 0.1);
}

.icon-button:active {
  background-color: black;
  box-shadow: 0 0 0 2px black;
  transition: background-color 0.2s ease, box-shadow 0.2s ease;
}

.icon-button:active {
  animation: active-click 0.4s forwards;
}

@keyframes active-click {
  0% {
    background-color: black;
  }
  100% {
    background-color: rgba(0, 0, 0, 0.1);
  }
}
