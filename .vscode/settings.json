  "workbench.editor.customLabels.patterns": {
    "**/routes/{+server,+layout,+page,+error}.{svelte,ts,server.ts,js,server.js}":
      "/ (${filename}.${extname})",
    "**/routes/*/{+server,+layout,+page,+error}.{svelte,ts,server.ts,js,server.js}":
      "/${dirname} (${filename}.${extname})",
